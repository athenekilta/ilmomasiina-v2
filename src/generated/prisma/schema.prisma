// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// #############################################################################
// DATA SCHEMAS
// #############################################################################

// An example data schema

model Example {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// #############################################################################
// NEXT AUTH SCHEMAS
// #############################################################################

// When extending user data, extend this model

model ManagementUser {
  id              String              @id @default(cuid())
  name            String?
  email           String?             @unique
  emailVerified   Boolean             @default(false)
  image           String?
  role            ManagementRole      @default(user)
  preferredLocale String              @default("fi")
  accounts        ManagementAccount[]
  sessions        ManagementSession[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum ManagementRole {
  user
  event_editor
  superadmin
}

model ManagementAccount {
  id                    String         @id
  accountId             String
  providerId            String
  userId                String
  user                  ManagementUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
}

model ManagementSession {
  id        String         @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      ManagementUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model ManagementVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  email     String
}

model PasswordChangeToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  email     String
}

/// Colour of the event card's badge. Picked by the admin rather than derived,
/// since the badge text is editorial ("Vuoden haippisin") and only the person
/// writing it knows how loud it should be.
enum BadgeTone {
  GREEN
  PINK
  DARK
}

enum EventImageState {
  PENDING
  ATTACHED
  RETIRED
  DELETING
}

model EventImage {
  id          String          @id @db.Uuid
  uploaderId  String
  createdAt   DateTime        @default(now())
  state       EventImageState @default(PENDING)
  deleteAfter DateTime?
  event       Event?

  @@index([state, deleteAfter])
}

model Event {
  imageId               String?            @unique @db.Uuid
  image                 EventImage?        @relation(fields: [imageId], references: [id])
  creationRequestId     String?            @unique @db.Uuid
  id                    Int                @id @default(autoincrement())
  translations          EventTranslation[]
  badgeTone             BadgeTone          @default(GREEN)
  date                  DateTime
  registrationStartDate DateTime
  registrationEndDate   DateTime
  openQuotaSize         Int                @default(0) // Legacy field, retained for migration compatibility
  extraCapacity         Int                @default(0)
  price                 String?
  location              String?
  webpageUrl            String?
  draft                 Boolean            @default(true)
  signupsPublic         Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?          @map("deletedAt") // Paranoid deletion setup
  Questions             Question[]
  Quotas                Quota[]
}

model EventTranslation {
  eventId           Int
  locale            String
  title             String
  /// Free-form marketing tag shown on the event card, e.g. "Vuoden haippisin"
  badgeText         String?
  description       String?
  verificationEmail String?
  event             Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, locale])
  @@index([locale])
}

enum QuestionType {
  text
  textarea
  radio
  checkbox
}

model Question {
  id           String                @id @default(cuid())
  type         QuestionType          @default(text)
  sortId       Int
  required     Boolean               @default(true)
  public       Boolean               @default(false)
  eventId      Int
  Event        Event                 @relation(fields: [eventId], references: [id])
  Translations QuestionTranslation[]
  Options      QuestionOption[]
  Answers      Answer[]

  @@index([eventId])
}

model QuestionTranslation {
  questionId String
  locale     String
  question   String
  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, locale])
  @@index([locale])
}

model QuestionOption {
  id           String                      @id @default(cuid())
  questionId   String
  sortId       Int
  Question     Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  Translations QuestionOptionTranslation[]
  Selections   AnswerSelection[]

  @@unique([questionId, sortId])
  @@index([questionId])
}

model QuestionOptionTranslation {
  optionId String
  locale   String
  label    String
  Option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@index([locale])
}

model Answer {
  id         String            @id @default(cuid())
  textValue  String?
  questionId String
  signupId   String
  Question   Question          @relation(fields: [questionId], references: [id])
  Signup     Signup            @relation(fields: [signupId], references: [id])
  Selections AnswerSelection[]

  @@unique([signupId, questionId], name: "signup_and_question")
}

model AnswerSelection {
  answerId String
  optionId String
  Answer   Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  Option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
  @@index([optionId])
}

model Signup {
  id                  String       @id @default(cuid())
  name                String
  completedAt         DateTime? // when signup process is completed
  createdAt           DateTime     @default(now())
  quotaId             String
  originalQuotaId     String
  status              SignupStatus @default(IN_PROGRESS)
  communicationLocale String       @default("fi")
  allocatedAt         DateTime?
  Quota               Quota        @relation("Quota", fields: [quotaId], references: [id])
  OriginalQuota       Quota        @relation("OriginalQuota", fields: [originalQuotaId], references: [id])
  Answers             Answer[]
  identityId          String
  identity            Identity     @relation(fields: [identityId], references: [id])
  signupGrant         SignupGrant?

  @@index([quotaId])
  @@index([identityId])
}

model Identity {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  signups   Signup[]
  grants    IdentityGrant[]
}

model UserSession {
  id             String          @id @default(cuid())
  tokenHash      String          @unique
  name           String?
  email          String?
  createdAt      DateTime        @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  signupGrants   SignupGrant[]
  identityGrants IdentityGrant[]

  @@index([expiresAt])
}

model SignupGrant {
  id       String        @id @default(cuid())
  signupId String        @unique
  signup   Signup        @relation(fields: [signupId], references: [id], onDelete: Cascade)
  sessions UserSession[]
  tokens   Token[]
}

model IdentityGrant {
  id         String        @id @default(cuid())
  identityId String        @unique
  identity   Identity      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sessions   UserSession[]
  tokens     Token[]
}

// Exactly one grant relation must be set. Signup tokens remain reusable;
// future identity tokens are consumed atomically by setting consumedAt.
model Token {
  id              String         @id @default(cuid())
  tokenHash       String         @unique
  signupGrantId   String?
  identityGrantId String?
  createdAt       DateTime       @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  signupGrant     SignupGrant?   @relation(fields: [signupGrantId], references: [id], onDelete: Cascade)
  identityGrant   IdentityGrant? @relation(fields: [identityGrantId], references: [id], onDelete: Cascade)

  @@index([signupGrantId])
  @@index([identityGrantId])
  @@index([expiresAt])
}

enum SignupStatus {
  IN_PROGRESS
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
}

// Every quota allocates its protected places immediately. Shared places are
// either unavailable, allocated immediately, or allocated after registration closes.
enum SharedPlacesAllocation {
  NEVER
  IMMEDIATE
  AFTER_REGISTRATION_CLOSE
}

model Quota {
  id                     String                 @id @default(cuid())
  size                   Int?
  sharedPlacesAllocation SharedPlacesAllocation @default(NEVER)
  sortId                 Int
  eventId                Int
  Event                  Event                  @relation(fields: [eventId], references: [id])
  Translations           QuotaTranslation[]
  Signups                Signup[]               @relation("Quota")
  OriginalSignups        Signup[]               @relation("OriginalQuota")

  @@index([eventId])
}

model QuotaTranslation {
  quotaId String
  locale  String
  title   String
  Quota   Quota  @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@id([quotaId, locale])
  @@index([locale])
}
